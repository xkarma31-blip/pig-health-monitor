{
  "name": "pig-health-monitor",
  "private": true,
  "scripts": {
    "lint": "cd v3-mqtt-pocketbase/frontend/mobile_app && npx eslint . --ext .ts,.tsx",
    "test": "cd v3-mqtt-pocketbase/frontend/mobile_app && npx jest",
    "prepare": "husky",
    "ci:backend": "bash -n v3-mqtt-pocketbase/backend/scripts/*.sh v3-mqtt-pocketbase/backend/thermal-pi/scripts/*.sh && find v3-mqtt-pocketbase/backend -name '*.py' -not -path '*/__pycache__/*' -exec python3 -m py_compile {} + && echo 'backend OK'",
    "scan:secrets": ".husky/pre-commit || true",
    "deploy:landing": "bash scripts/deploy-landing.sh",
    "diag:pi": "ssh pigpulse@192.168.69.1 'python3 ~/thermal-pi/scripts/pi_diag.py'",
    "health:pi": "ssh pigpulse@192.168.69.1 'python3 ~/scripts/health_check.py'",
    "health:local": "python3 v3-mqtt-pocketbase/backend/scripts/health_check.py --json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "typescript-eslint": "^8.59.4"
  },
  "lint-staged": {
    "v3-mqtt-pocketbase/frontend/mobile_app/src/**/*.{ts,tsx}": [
      "npx eslint --config v3-mqtt-pocketbase/frontend/mobile_app/eslint.config.mjs --fix --no-warn-ignored"
    ]
  }
}
