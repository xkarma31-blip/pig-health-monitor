{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "alerts": { ".indexOn": ["timestamp", "severity"] },
        "roster": { ".indexOn": ["lastSeen"] },
        "sensors": { ".indexOn": ["lastUpdated"] },
        "telemetry": { ".indexOn": ["timestamp"] }
      }
    }
  }
}
