<?xml version="1.0" encoding="utf-8"?>
<!--
  Light-theme widget container background.

  The provider selects this drawable (or its dark twin) at render time from the
  JSON `theme` field; it is never recoloured in code. Kept as a plain shape
  drawable so the widget has no artwork dependency beyond the copied logo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background_light" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_stroke_light" />
</shape>
