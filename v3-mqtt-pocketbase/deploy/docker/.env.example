# PigPulse v3 — Environment Variables
# Copy to .env and fill in values

# ── PocketBase ──────────────────────────────────────────────
PB_EMAIL=admin@pigpulse.local
PB_PASSWORD=admin123

# ── MQTT ───────────────────────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ── ValKey (Redis) ────────────────────────────────────────
VALKEY_URL=redis://valkey:6379

# ── WiFi (for ESP32 firmware) ─────────────────────────────
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD
MQTT_BROKER_IP=192.168.1.100

# ── Expo App ──────────────────────────────────────────────
EXPO_PUBLIC_POCKETBASE_URL=http://192.168.1.100:8090
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# ── OpenResty ─────────────────────────────────────────────
JWT_SECRET=pigpulse-secret-change-in-production
