[Unit]
Description=Set the static AP address on wlan0
# hostapd and dnsmasq both bind wlan0, so the address must exist first.
Before=hostapd.service dnsmasq.service

[Service]
Type=oneshot
ExecStart=/sbin/ip link set wlan0 up
ExecStart=/sbin/ip addr replace 192.168.69.1/24 dev wlan0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
