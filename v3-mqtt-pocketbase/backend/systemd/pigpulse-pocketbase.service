[Unit]
Description=PigPulse Local PocketBase Server
After=network.target

# The bind address below is created by wlan0-static-ip.service. Declaring the
# dependency is mandatory, not cosmetic: `After=network.target` says nothing
# about wlan0-static-ip.service, so on a cold boot PocketBase could win the
# race, fail to bind 192.168.69.1, and die. Because it exits 0 on some failures,
# `Restart=on-failure` below would then treat the death as a clean stop and
# never retry -- a permanent outage from a one-second ordering race.
Requires=wlan0-static-ip.service
After=wlan0-static-ip.service

[Service]
Type=simple
User=pigpulse
WorkingDirectory=/home/pigpulse/pocketbase
# Bound to the AP address ONLY — not 0.0.0.0 (which exposed an admin login to
# every client on the farm AP) and not 127.0.0.1 (which made it unreachable
# by the laptop-side cloud_sync worker, i.e. it re-created the two-island gap
# this binding was meant to close). The address is fixed by
# wlan0-static-ip.service, so this is stable.
#
# Exposure surface: anything that can associate with SSID PigPulse can reach
# the admin API. That is why the admin password is mandatory and lives in
# /etc/pigpulse/bridge.env, never in the repo.
ExecStart=/home/pigpulse/pocketbase/pocketbase serve --http=192.168.69.1:8090
# `always`, not `on-failure`. PocketBase serves forever when healthy, so any
# exit at all is a fault. With `on-failure` a failed migration (which exits 0)
# read as a clean stop and the service stayed down until a human noticed --
# measured on 2026-09-28: "Failed to apply migration ..._collections.name"
# then "Deactivated successfully", and it never retried.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
