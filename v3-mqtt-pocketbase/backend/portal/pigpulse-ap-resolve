#!/bin/sh
# Point the WHOLE AP stack at the measured AP radio, resolved by MAC.
#
# Radio interface names are not stable identities. Every AP component must
# therefore use the authoritative resolver and must fail visibly if the radio
# cannot be resolved; silently selecting another interface splits the AP stack.
AP_RADIO_MAC=dc:a6:32:87:63:a1
IFACE=$(/usr/local/sbin/pigpulse-wlan-iface "$AP_RADIO_MAC") || { echo "radio resolver failed for AP radio $AP_RADIO_MAC" >&2; exit 1; }
[ -n "$IFACE" ] || { echo "radio resolver returned no interface for AP radio $AP_RADIO_MAC" >&2; exit 1; }
sed -i "s/^interface=.*/interface=$IFACE/" /etc/hostapd/hostapd.conf 2>/dev/null || true
sed -i "s/^interface=.*/interface=$IFACE/" /etc/dnsmasq.conf 2>/dev/null || true
mkdir -p /etc/pigpulse
printf 'PIGPULSE_AP_IFACE=%s\n' "$IFACE" > /etc/pigpulse/ap-radio.env
echo "AP radio -> $IFACE"
exit 0
