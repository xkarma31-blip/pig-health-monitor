#!/bin/bash
# Split-radio uplink: the WAN radio -> venue; the AP radio stays on the other one.
#
# MAC-addressed, never name-addressed: radio interface names are not stable
# identities. Resolve both measured roles through the authoritative resolver;
# if either resolution fails, stop visibly instead of selecting another radio.
#
# The radio's OWN interface is used for the client: brcmfmac does not support
# adding a virtual managed interface, and the rtl8192cu dongle wedges on scan
# often enough to need a reset.
set -u
CONF=/etc/wpa_supplicant/wpa-split.conf
AP_RADIO_MAC=dc:a6:32:87:63:a1
WAN_RADIO_MAC=00:1f:05:6c:51:bc

AP_IF=$(/usr/local/sbin/pigpulse-wlan-iface "$AP_RADIO_MAC") || { echo "radio resolver failed for AP radio $AP_RADIO_MAC" >&2; exit 1; }
[ -n "$AP_IF" ] || { echo "radio resolver returned no interface for AP radio $AP_RADIO_MAC" >&2; exit 1; }
WAN_IF=$(/usr/local/sbin/pigpulse-wlan-iface "$WAN_RADIO_MAC") || { echo "radio resolver failed for WAN radio $WAN_RADIO_MAC" >&2; exit 1; }
[ -n "$WAN_IF" ] || { echo "radio resolver returned no interface for WAN radio $WAN_RADIO_MAC" >&2; exit 1; }
PID="/run/wpa_supplicant-$WAN_IF.pid"

# Never point the uplink at our own AP.
AP_MAC=$(cat "/sys/class/net/$AP_IF/address" 2>/dev/null | tr 'A-Z' 'a-z')
if [ -n "$AP_MAC" ] && grep -qi "bssid=$AP_MAC" "$CONF" 2>/dev/null; then
  echo "refusing: upstream BSSID is our own AP ($AP_MAC)"
  exit 1
fi

# The WAN radio can wedge in SCANNING and a plain `iw scan`
# returns nothing. A down/up of the interface resets the driver, so the uplink
# retries from a clean interface state instead of staying dead.
reset_iface() {
  pkill -f "wpa_supplicant.*-i $WAN_IF" 2>/dev/null || true
  ip link set "$WAN_IF" down 2>/dev/null || true
  sleep 2
  ip link set "$WAN_IF" up 2>/dev/null || true
  sleep 2
}

connect_once() {
  ip link set "$WAN_IF" up
  wpa_supplicant -B -i "$WAN_IF" -c "$CONF" -D nl80211 -P "$PID" || true
  for i in $(seq 1 30); do
    iw dev "$WAN_IF" link 2>/dev/null | grep -q "Connected to" && return 0
    sleep 1
  done
  return 1
}

if ! connect_once; then
  echo "uplink: no association on first try - resetting the WAN radio and retrying" >&2
  reset_iface
  connect_once || true
fi

dhcpcd -4 -m 50 -t 15 -q --noipv4ll --nohook resolv.conf "$WAN_IF" >/dev/null 2>&1 || true
GW=""
for i in $(seq 1 20); do
  GW=$(ip route show default 2>/dev/null | awk -v d="$WAN_IF" '$0 ~ "dev "d {print $3; exit}')
  [ -n "$GW" ] && break
  sleep 1
done
[ -n "$GW" ] && ip route replace default via "$GW" dev "$WAN_IF" metric 50
SSID=$(head -1 /etc/pigpulse/wan-sta.ssid 2>/dev/null || true)
BSSID=$(head -1 /etc/pigpulse/wan-sta.bssid 2>/dev/null || true)
WANT_FREQ=$(head -1 /etc/pigpulse/wan-sta.freq 2>/dev/null || true)
IP=$(ip -4 -o addr show "$WAN_IF" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
GW=$(ip route show default 2>/dev/null | awk -v d="$WAN_IF" '$0 ~ "dev "d {print $3; exit}')
CH=$(iw dev "$AP_IF" info 2>/dev/null | sed -n 's/.*channel \([0-9]*\).*/\1/p')
ASSOC=$(iw dev "$WAN_IF" link 2>/dev/null | sed -n 's/.*Connected to //p' | head -1)
# The ACTUAL band/frequency of the link we hold, read from the driver.
# The configured FREQ is only a TARGET: reporting it made the status file
# claim "band=5G" while ip=none and the radio was not connected at all.
ACTFREQ=$(iw dev "$WAN_IF" link 2>/dev/null | sed -n 's/.*freq: \([0-9]*\).*/\1/p' | head -1)
if [ -n "$ASSOC" ] && [ -n "$ACTFREQ" ]; then
  BAND=$([ "$ACTFREQ" -ge 4900 ] && echo 5G || echo 24)
  FREQ="$ACTFREQ"
else
  BAND=none
  FREQ=0
fi
mkdir -p /run/pigpulse
printf 'STATE=%s band=%s ip=%s gw=%s freq=%s want_freq=%s ch=%s want_bssid=%s assoc=%s wan=%s\n' \
  "$([ -n "$ASSOC" ] && [ -n "$IP" ] && echo UP || echo DOWN)" \
  "$BAND" \
  "${IP:-none}" "${GW:-none}" "${FREQ:-0}" "$WANT_FREQ" \
  "${CH:-0}" "${BSSID:-none}" \
  "${ASSOC:-none}" "$WAN_IF" > /run/pigpulse/wan-sta.status
chmod 644 /run/pigpulse/wan-sta.status 2>/dev/null || true
exit 0
